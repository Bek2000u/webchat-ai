{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "chrome"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "scripts/*.ts",
    "vite.config.ts",
    "src/extension/playwright/**/*.ts",
    "tests/extension/playwright/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/extension/.wxt"
  ]
}
