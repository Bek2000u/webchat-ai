# HTTP Basic dashboard login: admin / SERVER_TOKEN.
# The separate Server extension uses this same token for its bridge connection.
# Generate a long random value and keep this file's local .env copy private.
SERVER_TOKEN=
EXTENSION_ORIGINS=chrome-extension://opcdjnhnokdpibdhglkjfohgnjokakfp
# Host loopback port. Place an HTTPS reverse proxy in front for remote access.
PORT=8001
# Set your external HTTPS origin behind a reverse proxy so media URLs use HTTPS.
# PUBLIC_ORIGIN=https://webchat.example.com
PUBLIC_ORIGIN=
